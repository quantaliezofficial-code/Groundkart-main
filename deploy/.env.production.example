# Copy to /home/deploy/apps/groundkart/.env on the server, fill in every
# value marked CHANGE, then: chmod 600 .env
# Never commit the real file. Keep a copy of the secrets (especially
# FIELD_ENCRYPTION_KEY) in your password manager: without that key the
# encrypted identity and bank numbers in the database cannot be read.

# ---- Ports (bound to 127.0.0.1 only; host nginx proxies to WEB_PORT) ----
# Exotique already uses 3001 and 5000 on this VPS.
WEB_PORT=3002
API_PORT=5001

# ---- Database ----
# DB_MODE=bundled  GroundKart's own Postgres container (default, simplest).
# DB_MODE=shared   the VPS's existing PostgreSQL, like Exotique. Also set
#                  COMPOSE_FILE, DATABASE_URL and SHARED_DB_* below; see
#                  deploy/hostinger/compose.shared-postgres.yml.
DB_MODE=bundled
POSTGRES_DB=groundkart
POSTGRES_USER=groundkart
POSTGRES_PASSWORD=CHANGE-to-a-long-random-string

# Only for DB_MODE=shared:
# COMPOSE_FILE=docker-compose.yml:deploy/hostinger/compose.shared-postgres.yml
# DATABASE_URL=postgresql+asyncpg://groundkart_user:CHANGE@CHANGE-postgres-container:5432/groundkart_db
# SHARED_DB_NETWORK=CHANGE-network-name
# SHARED_DB_HOST=CHANGE-postgres-container
# SHARED_DB_NAME=groundkart_db
# SHARED_DB_USER=groundkart_user
# SHARED_DB_PASSWORD=CHANGE

# ---- Backups (deploy/hostinger/backup-db.sh) ----
BACKUP_DIR=/home/deploy/backups/groundkart
KEEP_BACKUPS=10

# ---- API workers ----
# KVM 1 has one vCPU: one worker is enough and uses the least memory.
WEB_CONCURRENCY=1

# ---- Security ----
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-to-a-64-character-random-string
# Encrypts ID numbers, PAN, GSTIN, bank account numbers and 2FA secrets.
# python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Never change it once data exists (rotation: FIELD_ENCRYPTION_OLD_KEYS).
FIELD_ENCRYPTION_KEY=CHANGE
# Admins must use an authenticator app in production (default true).
ADMIN_2FA_REQUIRED=true
# Keep these off in production (the defaults). Turn on only for a
# supervised session, then turn off again.
EXPOSE_API_DOCS=false
ADMIN_SQL_CONSOLE=false

# ---- URLs ----
PUBLIC_APP_URL=https://groundkart.com
APP_BASE_URL=https://groundkart.com
CORS_ALLOWED_ORIGINS=https://groundkart.com,https://www.groundkart.com

# ---- File storage ----
# "local" keeps uploads in a Docker volume on this server (fine to start).
# "s3" sends them to S3-compatible storage (Hostinger Object Storage,
# Cloudflare R2, AWS S3) — recommended once you have real traffic.
STORAGE_BACKEND=local
S3_BUCKET_NAME=
PRIVATE_S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ---- Password resets ----
# "Forgot password" creates a request that an admin completes from
# Admin > Passwords (no email service needed). This is unchanged.

# ---- Booking rules (defaults; admins can change them in Rules and fees) ----
BOOKING_HOLD_DURATION_MINUTES=1440
CANCELLATION_FULL_REFUND_HOURS=48
CANCELLATION_PARTIAL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_PERCENT=50
PLATFORM_COMMISSION_PERCENT=10

# ---- First super admin (used once by scripts.admin_setup) ----
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PHONE=CHANGE
ADMIN_NAME=CHANGE
